{
  "family": "task-definition-replit-app",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::030157669057:role/ecsTaskExecutionRole2",
  "containerDefinitions": [
    {
      "name": "replit-app",
      "image": "030157669057.dkr.ecr.us-east-1.amazonaws.com/ecr-repo-replit-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
